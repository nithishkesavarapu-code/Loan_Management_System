{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --include=dev",
  "buildCommand": "cd ../.. && npm run build --workspace @lms/shared && npm run build --workspace @lms/api",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/v1/health"
    },
    {
      "source": "/health",
      "destination": "/api/v1/health"
    }
  ]
}
